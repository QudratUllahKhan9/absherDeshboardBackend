# Backend ke env vars (Vercel → Settings → Environment Variables me yehi naam se daalein)
# Note: .env file Vercel pe kaam nahi karti — sirf local ke liye hai

PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/Abshar?retryWrites=true&w=majority

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
